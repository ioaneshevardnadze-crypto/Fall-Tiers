# Discord Developer Portal bot token. NEVER share this value.
DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE

# IDs: enable Developer Mode in Discord, then right-click server/role/channel > Copy ID.
GUILD_ID=YOUR_DISCORD_SERVER_ID
TESTER_ROLE_ID=YOUR_TESTER_ROLE_ID
APPLICATION_CHANNEL_ID=YOUR_APPLICATION_REVIEW_CHANNEL_ID
ANNOUNCEMENT_CHANNEL_ID=YOUR_TIER_ANNOUNCEMENTS_CHANNEL_ID

# Optional. Only fill these in after a secure webhook is implemented in the website backend.
WEBSITE_WEBHOOK_URL=
WEBSITE_WEBHOOK_SECRET=
